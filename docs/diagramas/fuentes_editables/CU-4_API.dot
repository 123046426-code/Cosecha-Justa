digraph G {
  rankdir=LR; splines=true; nodesep=0.35; ranksep=2.2; fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=13]; edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
  MOV [shape=box, style="filled,rounded", fillcolor="#FFF3D6", color="#B7791F", penwidth=2, label="«actor»\nAplicación móvil", margin="0.25,0.15"];
  WEB [shape=box, style="filled,rounded", fillcolor="#FFF3D6", color="#B7791F", penwidth=2, label="«actor»\nSistema web (Laravel)", margin="0.25,0.15"];
  BD [shape=box, style="filled,rounded", fillcolor="#EDEDED", color="#555555", penwidth=2, label="«sistema externo»\nPostgreSQL", margin="0.25,0.15"];
  subgraph cluster_sys { label="API (FastAPI)"; labeljust=c; fontsize=15; style="rounded"; color="#2B5A9B"; penwidth=2; margin=24;
    X01 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="OBJ-API-01\nServir como canal único de\ncomunicación", margin="0.18,0.08"];
    X02 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="OBJ-API-02\nAutenticar usuarios y\ncontrolar acceso por rol", margin="0.18,0.08"];
    X03 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="OBJ-API-03\nExponer servicios de\nusuarios y perfiles", margin="0.18,0.08"];
    X04 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="OBJ-API-04\nExponer servicios de\nproductos y categorías", margin="0.18,0.08"];
    X05 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="OBJ-API-05\nExponer servicios de\npedidos", margin="0.18,0.08"];
    X06 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="OBJ-API-06\nExponer servicios de\nventas, reportes y\nincidencias", margin="0.18,0.08"];
    X07 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="OBJ-API-07\nValidar datos y aplicar\nreglas del negocio", margin="0.18,0.08"];
    X08 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="OBJ-API-08\nDevolver respuestas y\nerrores consistentes", margin="0.18,0.08"];
    { rank=same; X01; X02; X03; X04; X05; X06; X07; X08; }
  }
  MOV -> X01 [dir=none];
  MOV -> X02 [dir=none];
  MOV -> X03 [dir=none];
  MOV -> X04 [dir=none];
  MOV -> X05 [dir=none];
  MOV -> X06 [dir=none];
  WEB -> X01 [dir=none];
  WEB -> X02 [dir=none];
  WEB -> X03 [dir=none];
  WEB -> X04 [dir=none];
  WEB -> X05 [dir=none];
  WEB -> X06 [dir=none];
  X03 -> BD [dir=none];
  X04 -> BD [dir=none];
  X05 -> BD [dir=none];
  X06 -> BD [dir=none];
  X03 -> X02 [style=dashed, label="«include»", constraint=false];
  X04 -> X02 [style=dashed, label="«include»", constraint=false];
  X05 -> X02 [style=dashed, label="«include»", constraint=false];
  X06 -> X02 [style=dashed, label="«include»", constraint=false];
}