digraph G {
  rankdir=LR; splines=true; nodesep=0.35; ranksep=2.2; fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=13]; edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
  ADM [shape=box, style="filled,rounded", fillcolor="#FFF3D6", color="#B7791F", penwidth=2, label="«actor»\nAdministrador", margin="0.25,0.15"];
  subgraph cluster_sys { label="Sistema web de administración – Perfil Administrador"; labeljust=c; fontsize=15; style="rounded"; color="#2B5A9B"; penwidth=2; margin=24;
    A01 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-01\nIniciar sesión", margin="0.18,0.08"];
    A02 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-02\nGestionar usuarios", margin="0.18,0.08"];
    A03 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-03\nGestionar y validar\nproductores", margin="0.18,0.08"];
    A04 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-04\nGestionar categorías", margin="0.18,0.08"];
    A05 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-05\nGestionar productos", margin="0.18,0.08"];
    A06 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-06\nGestionar pedidos", margin="0.18,0.08"];
    A07 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-07\nGenerar reportes y\nestadísticas", margin="0.18,0.08"];
    A08 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-08\nGestionar incidencias", margin="0.18,0.08"];
    A09 [shape=ellipse, style=filled, fillcolor="#E6F2EA", color="#2F6B3A", label="RF-ADM-09\nAdministrar catálogos", margin="0.18,0.08"];
    { rank=same; A01; A02; A03; A04; A05; A06; A07; A08; A09; }
  }
  ADM -> A01 [dir=none];
  ADM -> A02 [dir=none];
  ADM -> A03 [dir=none];
  ADM -> A04 [dir=none];
  ADM -> A05 [dir=none];
  ADM -> A06 [dir=none];
  ADM -> A07 [dir=none];
  ADM -> A08 [dir=none];
  ADM -> A09 [dir=none];
}