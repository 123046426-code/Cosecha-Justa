  unidades_medida [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8A97A6" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#8A97A6"><FONT COLOR="white"><B>unidades_medida</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_unidad"><B>id_unidad</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(30)</FONT></TD><TD>UK</TD></TR><TR><TD ALIGN="LEFT" PORT="abreviatura">abreviatura</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(10)</FONT></TD><TD></TD></TR></TABLE>>];
  productos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B5A9B" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2B5A9B"><FONT COLOR="white"><B>productos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_producto"><B>id_producto</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_productor"><I>id_productor</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_categoria"><I>id_categoria</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_unidad"><I>id_unidad</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion">descripcion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="precio">precio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(10,2)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad_disponible">cantidad_disponible</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(10,2)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="foto_url">foto_url</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(12)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_retiro">motivo_retiro</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD><TD></TD></TR></TABLE>>];
  opciones_entrega [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8A97A6" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#8A97A6"><FONT COLOR="white"><B>opciones_entrega</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_opcion"><B>id_opcion</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(40)</FONT></TD><TD>UK</TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion">descripcion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD><TD></TD></TR></TABLE>>];
  productor_opcion_entrega [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B5A9B" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2B5A9B"><FONT COLOR="white"><B>productor_opcion_entrega</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_productor"><B>id_productor</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>PK, FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_opcion"><B>id_opcion</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>PK, FK</TD></TR><TR><TD ALIGN="LEFT" PORT="costo_envio">costo_envio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(10,2)</FONT></TD><TD></TD></TR></TABLE>>];
  carritos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6B3A" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2F6B3A"><FONT COLOR="white"><B>carritos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_carrito"><B>id_carrito</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_consumidor"><I>id_consumidor</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_actualizacion">fecha_actualizacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  carrito_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6B3A" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2F6B3A"><FONT COLOR="white"><B>carrito_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_item"><B>id_item</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_carrito"><I>id_carrito</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_producto"><I>id_producto</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad">cantidad</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(10,2)</FONT></TD><TD></TD></TR></TABLE>>];
