digraph ER {
  rankdir=LR; splines=true; nodesep=0.45; ranksep=1.4; fontname="DejaVu Sans"; pad=0.3;
  node [shape=plain, fontname="DejaVu Sans", fontsize=11]; edge [color="#444444", arrowsize=0.9, penwidth=1.2];
  roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8A97A6" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#8A97A6"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol"><B>id_rol</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(30)</FONT></TD><TD>UK</TD></TR></TABLE>>];
  usuarios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B5A9B" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2B5A9B"><FONT COLOR="white"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><B>id_usuario</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol"><I>id_rol</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(80)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="apellidos">apellidos</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="correo">correo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(120)</FONT></TD><TD>UK</TD></TR><TR><TD ALIGN="LEFT" PORT="contrasena_hash">contrasena_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono">telefono</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="activo">activo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro">fecha_registro</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
  productores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B5A9B" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2B5A9B"><FONT COLOR="white"><B>productores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_productor"><B>id_productor</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><I>id_usuario</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_negocio">nombre_negocio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion">descripcion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TEXT</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="municipio">municipio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(80)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(60)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="estatus_validacion">estatus_validacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(15)</FONT></TD><TD></TD></TR></TABLE>>];
  consumidores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2B5A9B" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2B5A9B"><FONT COLOR="white"><B>consumidores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_consumidor"><B>id_consumidor</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><I>id_usuario</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="direccion">direccion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="municipio">municipio</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(80)</FONT></TD><TD></TD></TR></TABLE>>];
