  calificaciones [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6B3A" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2F6B3A"><FONT COLOR="white"><B>calificaciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_calificacion"><B>id_calificacion</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_pedido"><I>id_pedido</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_producto"><I>id_producto</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_consumidor"><I>id_consumidor</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="puntuacion">puntuacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SMALLINT</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="comentario">comentario</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(300)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha">fecha</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
