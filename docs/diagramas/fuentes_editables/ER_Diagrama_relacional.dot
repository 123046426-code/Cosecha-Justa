  pedidos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2F6B3A" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2F6B3A"><FONT COLOR="white"><B>pedidos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_pedido"><B>id_pedido</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">SERIAL</FONT></TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_consumidor"><I>id_consumidor</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_productor"><I>id_productor</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_opcion"><I>id_opcion</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="id_estado"><I>id_estado</I></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT" PORT="total">total</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NUMERIC(10,2)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion_entrega">direccion_entrega</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_rechazo">motivo_rechazo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD><TD></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_pedido">fecha_pedido</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIMESTAMP</FONT></TD><TD></TD></TR></TABLE>>];
